#!/usr/bin/env python3
"""bus-inbox — Read an agent's inbox."""
import argparse, json, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "server"))
from bus import poll, peek, ack, get_sticky_directives

p = argparse.ArgumentParser(description="Read session bus inbox")
p.add_argument("agent_id", help="Agent ID")
p.add_argument("--ack", action="store_true", help="Mark as delivered")
p.add_argument("--peek", action="store_true", help="Peek without delivering")
p.add_argument("--directives", action="store_true", help="Show sticky directives")
args = p.parse_args()

if args.directives:
    dirs = get_sticky_directives(args.agent_id)
    print(json.dumps(dirs, indent=2))
elif args.peek:
    msgs = peek(args.agent_id)
    print(json.dumps(msgs, indent=2))
elif args.ack:
    msgs = poll(args.agent_id)
    print(json.dumps(msgs, indent=2))
else:
    msgs = poll(args.agent_id)
    print(json.dumps(msgs, indent=2))
