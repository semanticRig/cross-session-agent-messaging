#!/usr/bin/env python3
"""Register the current session. Safe — no shell interpolation."""
import argparse, json, os, socket, subprocess, sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "server"))
from registry import register, _generate_session_id

def get_branch():
    try:
        return subprocess.check_output(
            ["git", "branch", "--show-current"], stderr=subprocess.DEVNULL, text=True
        ).strip()
    except Exception:
        return ""

p = argparse.ArgumentParser(description="Register an OpenCode session")
p.add_argument("--desc", default="", help="Session description")
p.add_argument("--lock", default="", help="Comma-separated locked files")
p.add_argument("--tags", default="", help="Comma-separated tags")
p.add_argument("--id", default="", help="Session ID (auto-generated if omitted)")
p.add_argument("--pid", type=int, default=os.getppid(), help="PID to register")
args = p.parse_args()

sid = args.id or _generate_session_id()
locked = [f.strip() for f in args.lock.split(",") if f.strip()] if args.lock else []
tags = [t.strip() for t in args.tags.split(",") if t.strip()] if args.tags else []

entry = register(
    sid,
    pid=args.pid,
    working_dir=os.getcwd(),
    branch=get_branch(),
    description=args.desc,
    locked_files=locked,
    tags=tags,
)

print(json.dumps({"session_id": sid, "ok": True}, indent=2))
